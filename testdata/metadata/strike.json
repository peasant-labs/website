          { "key": "callId", "note": "the call id, matched by its output" },
          { "key": "name", "note": "the tool name; Task launches a subagent" },
          { "key": "input", "note": "the tool call arguments" },
          { "key": "output", "note": "what the tool returned" }
        ]
      },
      {
        "id": "turn-identity",
