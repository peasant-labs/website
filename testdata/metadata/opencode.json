          { "key": "callID", "note": "the call id, matched by its state" },
          { "key": "tool", "note": "the tool's own name" },
          { "key": "state.status", "note": "completed once the call returned" },
          { "key": "state.input", "note": "the tool call arguments" },
          { "key": "state.output", "note": "what the tool returned" }
        ]
      },
