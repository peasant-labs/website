    "groups": [
      {
        "id": "identity",
        "selectors": [
          "path",
          "records[*].id",
          "records[*].message.model"
        ],
        "fields": [
          {
            "key": "path",
            "note": "one JSON Lines file per session under the agent sessions directory"
          },
          {
            "key": "id",
            "note": "the session header id; becomes the unified id"
          },
          {
            "key": "message.model",
            "note": "the model on an assistant message; becomes the unified model"
          }
        ]
      },
      {
        "id": "session",
        "selectors": [
          "records[*].cwd",
          "records[*].timestamp"
        ],
        "fields": [
          {
            "key": "cwd",
            "note": "the absolute working directory on the session header; becomes workingDirectory"
          },
          {
            "key": "timestamp",
            "note": "the entry time; the first and last become startTime and endTime"
          }
        ]
      },
      {
        "id": "usage",
        "selectors": [
          "records[*].message.usage"
        ],
        "fields": [
          {
            "key": "input",
            "note": "input tokens; summed into tokensIn"
          },
          {
            "key": "output",
            "note": "output tokens; summed into tokensOut"
          }
        ]
      },
      {
        "id": "git",
        "selectors": [
          "records[*].cwd"
        ],
        "fields": [
          {
            "key": "cwd",
            "note": "the recording carries no branch; the git context is resolved from the working directory"
          }
        ]
      },
      {
        "id": "turns",
        "selectors": [
          "records"
        ],
        "fields": [
          {
            "key": "type",
            "note": "session, model_change, message, or compaction"
          },
          {
            "key": "message.role",
            "note": "user, assistant, or toolResult; becomes the unified turn role"
          },
          {
            "key": "message.toolCallId",
            "note": "the call a toolResult message answers"
          },
          {
            "key": "agent",
            "note": "a subagent message; it lowers to a turn carrying the agent name"
          },
          {
            "key": "summary",
            "note": "compaction: a control entry whose text is retained evidence, not dropped"
          }
        ]
      },
      {
        "id": "tool-calls",
        "selectors": [
          "records[*].message.content[*]"
        ],
        "fields": [
          {
            "key": "type",
            "note": "thinking, text, or toolCall"
          },
          {
            "key": "id",
            "note": "the call id, matched by its result"
          },
          {
            "key": "name",
            "note": "the tool name; Task launches a subagent"
          },
          {
            "key": "arguments",
            "note": "the tool call input"
          },
          {
            "key": "text",
            "note": "a toolResult's returned text, or an assistant text block"
          }
        ]
      },
      {
        "id": "turn-identity",
        "selectors": [
          "records[*].message.model",
          "records[*].agent"
        ],
        "fields": [
          {
            "key": "message.model",
            "note": "the model that produced the turn; repeated per assistant message"
          },
          {
            "key": "agent",
            "note": "a subagent turn; it carries the agent name"
          }
        ]
      },
      {
        "id": "turn-usage",
        "selectors": [
          "records[*].message.usage"
        ],
        "fields": [
          {
            "key": "message.usage.input",
            "note": "the turn's input tokens; summed into tokensIn"
          },
          {
            "key": "message.usage.output",
            "note": "the turn's output tokens; summed into tokensOut"
          }
        ]
