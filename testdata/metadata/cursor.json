        "id": "turns",
        "selectors": ["records"],
        "fields": [
          { "key": "role", "note": "user or assistant; becomes the unified turn role" },
          { "key": "at", "note": "the record time, used to order turns" },
          { "key": "agentName", "note": "a subagent record; it lowers to a turn with agentName" },
          { "key": "type", "note": "turn_ended: a control record that writes no turn and does not block completeness" },
          { "key": "content", "note": "the record's blocks; an undeclared block type is kept as complete redacted evidence, not dropped" }
        ]
      },
      {
        "id": "tool-calls",
        "selectors": ["records[*].content[*]"],
        "fields": [
          { "key": "type", "note": "text, tool_use, or tool_result" },
          { "key": "id", "note": "the call id, matched by its result" },
          { "key": "name", "note": "the tool name; Task launches a subagent" },
          { "key": "input", "note": "the call arguments" }
        ]
      },
      {
        "id": "turn-identity",
        "selectors": ["records[*].model"],
        "fields": [
          { "key": "model", "note": "the model that produced the turn; the session-level model repeats here per turn" },
          { "key": "agentName", "note": "a subagent turn; it carries the subagent's own model" }
        ]
      },
      {
        "id": "turn-usage",
        "selectors": ["records[*].usage"],
        "fields": [
          { "key": "usage.input_tokens", "note": "the turn's input tokens; summed into tokensIn" },
          { "key": "usage.output_tokens", "note": "the turn's output tokens; summed into tokensOut" }
