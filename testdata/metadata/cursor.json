    "groups": [
      {
        "id": "identity",
        "selectors": [
          "path",
          "records[*].message.model"
        ],
        "fields": [
          {
            "key": "path",
            "note": "one transcript per session under agent-transcripts; the directory and file name carry the session id"
          },
          {
            "key": "message.model",
            "note": "the model that answered; absent when Cursor omits it"
          },
          {
            "key": "subagent.path",
            "note": "a subagent transcript nested under its parent's directory"
          }
        ]
      },
      {
        "id": "session",
        "selectors": [
          "path",
          "records[*].timestamp"
        ],
        "fields": [
          {
            "key": "path",
            "note": "the workspace directory in the path identifies the project; becomes workingDirectory"
          },
          {
            "key": "timestamp",
            "note": "the record time; the first and last become startTime and endTime"
          }
        ]
      },
      {
        "id": "usage",
        "selectors": [
          "records[*].message.usage",
          "subagent.records[*].message.usage"
        ],
        "fields": [
          {
            "key": "input_tokens",
            "note": "input tokens; summed into tokensIn"
          },
          {
            "key": "output_tokens",
            "note": "output tokens; summed into tokensOut"
          }
        ]
      },
      {
        "id": "git",
        "selectors": [
          "path"
        ],
        "fields": [
          {
            "key": "path",
            "note": "the workspace path identifies the repository; branch and remote are resolved with git, not recorded in the transcript"
          }
        ]
      },
      {
        "id": "turns",
        "selectors": [
          "records",
          "subagent.records"
        ],
        "fields": [
          {
            "key": "role",
            "note": "user or assistant; becomes the unified turn role"
          },
          {
            "key": "timestamp",
            "note": "the record time, used to order turns"
          },
          {
            "key": "type",
            "note": "turn_ended: a control record that writes no turn and does not block completeness"
          },
          {
            "key": "message.content",
            "note": "the record's blocks; a nested subagent transcript holds its own records"
          },
          {
            "key": "content",
            "note": "an undeclared block type (web_search) is kept as complete redacted evidence, not dropped"
          }
        ]
      },
      {
        "id": "tool-calls",
        "selectors": [
          "records[*].message.content[*]",
          "subagent.records[*].message.content[*]"
        ],
        "fields": [
          {
            "key": "type",
            "note": "text, tool_use, or tool_result"
          },
          {
            "key": "id",
            "note": "the call id, matched by its result"
          },
          {
            "key": "name",
            "note": "the tool name; Task launches a subagent"
          },
          {
            "key": "input",
            "note": "the call arguments"
          },
          {
            "key": "tool_use_id",
            "note": "on a tool_result, the call it answers"
          },
          {
            "key": "content",
            "note": "what the tool returned"
          }
        ]
      },
      {
        "id": "turn-identity",
        "selectors": [
          "records[*].message.model",
          "subagent.records[*].message.model"
        ],
        "fields": [
          {
            "key": "message.model",
            "note": "the model that produced the turn; repeated per assistant record"
          },
          {
            "key": "subagent.records",
            "note": "the subagent transcript's own turns carry the subagent's model"
          }
        ]
      },
      {
        "id": "turn-usage",
        "selectors": [
          "records[*].message.usage",
          "subagent.records[*].message.usage"
        ],
        "fields": [
          {
            "key": "message.usage.input_tokens",
            "note": "the turn's input tokens; summed into tokensIn"
          },
          {
            "key": "message.usage.output_tokens",
            "note": "the turn's output tokens; summed into tokensOut"
          }
        ]
      }
    ]
  },
